{
  "name": "recoup",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "node scripts/check-test-count.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p convex/tsconfig.json --noEmit",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "postinstall": "patch-package --error-on-fail",
    "verify:patch": "node scripts/check-patch.mjs",
    "codegen:check": "node scripts/check-codegen.mjs",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "playwright test",
    "deploy": "npx @convex-dev/static-hosting deploy"
  },
  "dependencies": {
    "@agentmail/convex": "0.1.0",
    "@auth/core": "0.41.3",
    "@convex-dev/auth": "^0.0.95",
    "@convex-dev/rate-limiter": "0.4.0",
    "@convex-dev/static-hosting": "^0.2.1",
    "@firecrawl/firecrawl-convex": "^0.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "convex": "^1.46.0",
    "openai": "^7.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@convex-dev/workpool": "^0.3.2",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "convex-test": "^0.0.59",
    "happy-dom": "20.14.5",
    "oxlint": "^1.81.0",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
