# Copy to .env.local. `npx convex dev` writes these for you when it links a deployment.
# Only public, client-side values belong here.
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Secrets (OpenAI, Firecrawl, AgentMail keys) never go in this file or in git.
# They live in the Convex deployment environment:
#   npx convex env set NAME value
# See README.md for the list of names.
