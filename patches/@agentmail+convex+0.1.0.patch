--- a/node_modules/@agentmail/convex/src/component/lib.ts
+++ b/node_modules/@agentmail/convex/src/component/lib.ts
@@ -580,3 +580,107 @@ export const cleanupFinalizedOutbound = mutation({
     }
   },
 });
+
+// ---------------------------------------------------------------------------
+// T18.4 (D115 6b-5): account-deletion purge.
+//
+// The component previously had no way to remove a single inbox's data --
+// `inboundMessages`/`outboundMessages`/`events` retained mail content and
+// webhook payloads forever, so the app's account-deletion purge
+// (`convex/account.ts`'s `purge`) had nothing to call before it deletes the
+// remote AgentMail inbox over REST. `purgeInbox` fixes that.
+//
+// Platform constraint (see `convex/account.ts`'s own `purgeStep` for the
+// prior art this mirrors): a single Convex function execution may issue at
+// most ONE `.paginate()` call. A purge that needs to drain three tables
+// therefore cannot loop through all three in one call -- each call drains
+// one page of ONE table (<= `PURGE_PAGE` rows), and the returned cursor
+// encodes which table is current so the caller (`convex/mailPurge.ts`'s
+// `purgeInboxData`) can keep calling until every table is empty.
+//
+// Every query below goes through that table's `by_inbox` index and an exact
+// `.eq("inboxId", inboxId)` match, so a call for one inbox can structurally
+// never observe -- let alone delete -- another inbox's rows.
+// ---------------------------------------------------------------------------
+
+const PURGE_PAGE = 200;
+
+/** `purgeInbox`'s table order: cheapest/most-numerous first, no ordering
+ * dependency between them (unlike `account.ts`'s child-before-parent
+ * requirement -- these three tables don't reference each other). */
+const PURGE_PHASES = ["inbound", "outbound", "events", "done"] as const;
+type PurgePhase = (typeof PURGE_PHASES)[number];
+
+const PURGE_PHASE_TABLE: Record<Exclude<PurgePhase, "done">, "inboundMessages" | "outboundMessages" | "events"> = {
+  inbound: "inboundMessages",
+  outbound: "outboundMessages",
+  events: "events",
+};
+
+type PurgeCursorState = { phase: PurgePhase; sub: string | null };
+
+function decodePurgeCursor(raw: string | undefined): PurgeCursorState {
+  if (raw) {
+    try {
+      const parsed = JSON.parse(raw) as Partial<PurgeCursorState>;
+      if (
+        (parsed.phase === "inbound" || parsed.phase === "outbound" || parsed.phase === "events" || parsed.phase === "done") &&
+        (parsed.sub === null || typeof parsed.sub === "string")
+      ) {
+        return { phase: parsed.phase, sub: parsed.sub ?? null };
+      }
+    } catch {
+      // Malformed/foreign cursor: restart the walk from the first phase
+      // rather than throwing -- same tolerance `account.ts`'s `purgeStep`
+      // applies to an unrecognized `progress.table`.
+    }
+  }
+  return { phase: "inbound", sub: null };
+}
+
+function nextPurgePhase(phase: PurgePhase): PurgePhase {
+  const idx = PURGE_PHASES.indexOf(phase);
+  return PURGE_PHASES[Math.min(idx + 1, PURGE_PHASES.length - 1)];
+}
+
+/**
+ * Deletes at most `PURGE_PAGE` rows from ONE table, scoped to `inboxId` via
+ * that table's `by_inbox` index. Call repeatedly, feeding back the returned
+ * `cursor`, until it comes back `null` -- that's the only signal that every
+ * `inboundMessages`/`outboundMessages`/`events` row for this inbox is gone
+ * ("purgeInboxComplete"). A `cursor` still comes back when the current
+ * table's page merely advances to the next table, even if this call deleted
+ * 0 rows (an inbox with, say, no `outboundMessages` still spends one call
+ * moving past that phase) -- callers must loop on `cursor !== null`, not on
+ * `deleted > 0`.
+ */
+export const purgeInbox = internalMutation({
+  args: { inboxId: v.string(), cursor: v.optional(v.string()) },
+  returns: v.object({
+    cursor: v.union(v.string(), v.null()),
+    deleted: v.number(),
+  }),
+  handler: async (ctx, args) => {
+    const state = decodePurgeCursor(args.cursor);
+    if (state.phase === "done") return { cursor: null, deleted: 0 };
+
+    const table = PURGE_PHASE_TABLE[state.phase];
+    // The one `.paginate()` call this execution is allowed to make.
+    const page = await (ctx.db.query(table) as any)
+      .withIndex("by_inbox", (q: any) => q.eq("inboxId", args.inboxId))
+      .paginate({ cursor: state.sub, numItems: PURGE_PAGE });
+
+    for (const row of page.page) {
+      await ctx.db.delete(row._id);
+    }
+
+    const next: PurgeCursorState = page.isDone
+      ? { phase: nextPurgePhase(state.phase), sub: null }
+      : { phase: state.phase, sub: page.continueCursor };
+
+    return {
+      cursor: next.phase === "done" ? null : JSON.stringify(next),
+      deleted: page.page.length,
+    };
+  },
+});
